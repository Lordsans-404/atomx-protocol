            ],
            "type": "u64"
          },
          {
            "name": "remaining_stake",
            "docs": [
              "Remaining stake after partial slashing"
            ],
            "type": "u64"
          },
          {
            "name": "spl_mint",
            "docs": [
              "USDC mint address"
            ],
            "type": "pubkey"
          },
          {
            "name": "duration_days",
            "docs": [
              "Duration of the commitment in days (1-365)"
            ],
            "type": "u16"
          },
          {
            "name": "daily_target_minutes",
            "docs": [
              "Target minutes per day"
            ],
            "type": "u16"
          },
          {
            "name": "current_day",
            "docs": [
              "Last day number with a validated proof"
            ],
            "type": "u16"
          },
          {
            "name": "failed_count",
            "docs": [
              "Number of failures (max 2 = terminated)"
            ],
            "type": "u8"
          },
          {
            "name": "early_finish_count",
            "docs": [
              "Number of early finishes (>50% but <100% of target)"
            ],
            "type": "u8"
          },
          {
            "name": "proof_count",
            "docs": [
              "Number of validated proofs submitted"
            ],
            "type": "u16"
          },
          {
